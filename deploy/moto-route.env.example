# Optional settings for the route mapper service.
# Copy to /etc/moto-route.env and edit; every line is KEY=value, no `export`.
# Restart after changing: sudo systemctl restart moto-route

# --- fuel planning ---------------------------------------------------------
# Usable tank range in km, and the fraction held back as reserve.
#MOTO_TANK_RANGE_KM=250
#MOTO_FUEL_RESERVE=0.15

# --- ride defaults ---------------------------------------------------------
#MOTO_SPEED_KMH=65

# --- live incident feeds ---------------------------------------------------
# Comma-separated GeoJSON incident feed URLs from your road authority.
#MOTO_INCIDENT_FEEDS=https://example.org/incidents.geojson
# Germany's Autobahn API is keyless and on by default. Set to 0 to disable.
#MOTO_AUTOBAHN=1
# Pin the motorways instead of detecting them from the route.
#MOTO_AUTOBAHN_ROADS=A8,A81
# Each road costs three requests, so the fan-out is capped.
#MOTO_MAX_AUTOBAHN_ROADS=8
#MOTO_MAX_INCIDENTS=150
#MOTO_INCIDENT_TTL=600

# --- offline tiles ---------------------------------------------------------
# OpenStreetMap's tile policy names 250 tiles as the limit for an area. Raise
# this ONLY if you have pointed the app at a tile server you run yourself — the
# tile URLs are in moto_route/static/js/mapview.js, not an env var.
#MOTO_MAX_CACHED_TILES=250
#MOTO_TILE_DELAY_MS=120

# --- self-hosted services --------------------------------------------------
# Overpass grants about two concurrent slots per IP and this app asks it three
# questions, so queries are queued. Raise only for an Overpass you run yourself.
#MOTO_OVERPASS_CONCURRENCY=1
# Seconds Overpass may spend on one query. Long routes make expensive queries;
# this is declared in the query and used as the HTTP timeout, so the two agree.
#MOTO_OVERPASS_TIMEOUT=90
# Other Overpass instances to fall back to when one refuses the connection.
# Comma-separated; set to an empty value to use only the primary.
#MOTO_OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter

# The public OSRM demo server is rate-limited and not meant for regular use.
#MOTO_OSRM_URL=http://127.0.0.1:5000
#MOTO_OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- everything off --------------------------------------------------------
# Map and route only; no outbound requests at all.
#MOTO_OFFLINE=1
