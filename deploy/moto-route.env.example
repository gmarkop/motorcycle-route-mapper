# Optional settings for the route mapper service.
# Copy to /etc/moto-route.env and edit; every line is KEY=value, no `export`.
# Restart after changing: sudo systemctl restart moto-route

# --- fuel planning ---------------------------------------------------------
# Usable tank range in km, and the fraction held back as reserve.
#MOTO_TANK_RANGE_KM=250
#MOTO_FUEL_RESERVE=0.15

# --- ride defaults ---------------------------------------------------------
#MOTO_SPEED_KMH=65

# --- live incident feeds ---------------------------------------------------
# Comma-separated GeoJSON incident feed URLs from your road authority.
#MOTO_INCIDENT_FEEDS=https://example.org/incidents.geojson
# Germany's Autobahn API is keyless and on by default. Set to 0 to disable.
#MOTO_AUTOBAHN=1
# Pin the motorways instead of detecting them from the route.
#MOTO_AUTOBAHN_ROADS=A8,A81
# Each road costs three requests, so the fan-out is capped.
#MOTO_MAX_AUTOBAHN_ROADS=8
#MOTO_MAX_INCIDENTS=150
#MOTO_INCIDENT_TTL=600

# --- offline tiles ---------------------------------------------------------
# OpenStreetMap's tile policy names 250 tiles as the limit for an area. Raise
# this ONLY if you have pointed the app at a tile server you run yourself — the
# tile URLs are in moto_route/static/js/mapview.js, not an env var.
#MOTO_MAX_CACHED_TILES=250
#MOTO_TILE_DELAY_MS=120

# Terrain model, asked only when a GPX carries no heights of its own -- which
# is most files produced by online route converters. Copernicus GLO-90 at 90 m.
#MOTO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
# Terrain does not move, so this is cached for a month rather than minutes.
#MOTO_ELEVATION_TTL=2592000
# Spacing of elevation samples, and the cap on how many are taken. The cap is
# also a cap on requests: Open-Meteo takes 100 coordinates at a time.
#MOTO_ELEVATION_SAMPLE_M=250
#MOTO_MAX_ELEVATION_SAMPLES=600
# When a stretch is called out as demanding: twisty AND steep, held for
# long enough to be a real piece of road. 130 deg/km is where the map's own
# labels switch from "flowing" to "twisty", so the two agree.
#MOTO_DEMANDING_CURVINESS=130
#MOTO_DEMANDING_GRADIENT=5
#MOTO_DEMANDING_MIN_M=300

# --- self-hosted services --------------------------------------------------
# Overpass grants about two concurrent slots per IP, so two is its documented
# allowance rather than a gamble: it lets the closure and POI layers run at the
# same time instead of one waiting out the other. Drop to 1 if you see 429s;
# raise it only for an Overpass you run yourself.
#MOTO_OVERPASS_CONCURRENCY=2
# How long an answer that is missing sections is cached. Much shorter than the
# complete one, because the panel tells you to press Refresh to try the rest,
# and a six-hour cache would replay the same gaps instead of asking again.
#MOTO_PARTIAL_TTL=300
# Seconds Overpass may spend on one query. Long routes make expensive queries;
# this is declared in the query and used as the HTTP timeout, so the two agree.
#MOTO_OVERPASS_TIMEOUT=90
# Route coordinates per Overpass query. Cost grows with corridor length, so a
# long route is split into several cheap queries instead of one that is refused.
#MOTO_OVERPASS_MAX_POINTS=60
# Total seconds one layer may spend on Overpass. Past this it returns what it
# has and says how much was skipped, rather than leaving a panel empty.
#MOTO_OVERPASS_DEADLINE=120
# "filtered" keeps each tag filter inside its own around (tag-indexed, small
# results). "grouped" walks the corridor twice into named sets — fewer passes,
# but it materialises every road first and times out in built-up areas.
#MOTO_OVERPASS_QUERY_STYLE=filtered
# Other Overpass instances to fall back to when one refuses the connection.
# Comma-separated; set to an empty value to use only the primary.
#MOTO_OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter
# What your own Overpass actually holds, as Geofabrik .poly clipping
# boundaries -- the exact shape of the imported data. Only set this when
# MOTO_OVERPASS_URL points at a server built from country extracts: outside its
# data it answers "nothing here" with total confidence, which is
# indistinguishable from a clear road. build-extract.sh downloads these
# alongside each country and prints the line to paste.
#MOTO_OVERPASS_COVERAGE_FILES=/var/lib/overpass-build/poly/greece.poly,/var/lib/overpass-build/poly/italy.poly
# A cruder alternative, kept for a mirror whose coverage really is a rectangle.
# Do not use it for a set of countries: the box around Greece and Italy also
# contains Albania, Croatia, Slovenia, Bosnia, Montenegro, Serbia, Bulgaria,
# western Turkey and part of Tunisia -- every one of which would be answered
# "no closures" by a database that holds none of them.
#MOTO_OVERPASS_COVERAGE=34.5,-5.5,55.5,29.5

# The public OSRM demo server is rate-limited and not meant for regular use.
#MOTO_OSRM_URL=http://127.0.0.1:5000
#MOTO_OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- everything off --------------------------------------------------------
# Map and route only; no outbound requests at all.
#MOTO_OFFLINE=1
